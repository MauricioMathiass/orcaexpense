{
  "name": "orcaexpense-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "API do OrçaFY Expense (Express + Prisma + PostgreSQL no Neon, login pelo Neon Auth)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "prisma generate",
    "start": "node src/server.js",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "dotenv-cli": "^8.0.0"
  }
}
