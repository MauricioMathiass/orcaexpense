# Copie para ".env.local". As duas variáveis abaixo são públicas (vão para o navegador): nunca ponha segredos aqui.

# URL do Neon Auth: a mesma NEON_AUTH_BASE_URL do Backend/.env.local (gerado por "neon deploy").
VITE_NEON_AUTH_URL=

# Endereço da API (pasta Backend).
VITE_API_URL=http://localhost:3001
